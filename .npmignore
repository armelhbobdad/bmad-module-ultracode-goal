# Git
.git
.gitignore
.gitattributes
.github

# Documentation (root-level .md files except README)
/*.md
!/README.md

# BMAD framework and IDE config (not part of the module)
_bmad/
_bmad-output/
.claude/
.cursor/

# Generated agent skills: committed to git, but project tooling, not module content
/skf-skills/

# Written by `npx skills add` in a contributor's checkout: never module content
/skills-lock.json
/.agents/

# Agent-skill workspace artifacts (briefs, improvement queue): never module content
/forge-data/

# Development tools and config
test/
*.test.js
eslint.config.mjs
prettier.config.mjs
.markdownlint-cli2.yaml
.prettierignore
.eslintrc.*
.prettierrc.*
.husky/
.npmrc
.nvmrc

# Maintainer tools. Every file directly under tools/ is one (validators,
# docs build, release notes, the tool-versions list), except the npx wrapper
# that package.json's bin points at. The pattern matches only that level: the
# installer CLI in tools/cli/ still ships.
tools/*
!tools/cli/
!tools/ucg-npx-wrapper.js

# Change fragments: rendered into CHANGELOG.md and the GitHub Release at
# release time, not read at runtime.
changes/

# Maintainer-only release material: the runbook and the ruleset and
# environment baselines. STABILITY.md ships on purpose: it is the
# public contract, which a consumer pinning a major may want to read from the
# installed package.
docs/_internal/RELEASING.md
release-audits/

# The docs website: its source and build, published as the docs site, not
# part of the module.
website/

# Skill dev/test artifacts (not needed at runtime)
skills/**/.analysis/
skills/**/.decision-log.md
skills/**/.memlog.md
skills/**/scripts/tests/
skills/**/__pycache__/
skills/**/.pytest_cache/
skills/reports/
skills/ultracode-goal/assets/ucg-awareness/shaping-decision.md

# Python bytecode
__pycache__/
*.pyc

# Output and temp
temp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Misc
*.log
.env
.env.*

# Browser-automation session artifacts (screenshots, snapshots)
.playwright-mcp/

# Learning material scaffold: gitignored, so npm would otherwise pack a stale copy
_ucg-learn/
_skf-learn/

# Local build and generated output. These are gitignored, but the presence of
# this file disables npm's .gitignore fallback entirely, so they must be listed
# here too or a pack from a working tree carries them (measured: 367 files /
# 21.2 MB against the 97 a release publishes from a clean CI checkout).
build/
data/
graphify-out/
/.cocoindex_code/
.boost/

# IWE workspace and project memory for AI sessions: repository knowledge, not
# part of the module. Root MEMORY.md is already covered by the /*.md rule above.
/.iwe/
/memory/
