# Git
.git
.gitignore
.github

# Documentation (root-level .md files except README)
/*.md
!/README.md

# BMAD framework and IDE config (not part of the module)
_bmad/
_bmad-output/
.claude/
.cursor/

# Development tools and config
test/
*.test.js
eslint.config.mjs
prettier.config.mjs
.markdownlint-cli2.yaml
.prettierignore
.eslintrc.*
.prettierrc.*
.husky/
.npmrc

# Dev-only validation tools (not needed at runtime)
tools/validate-skills.js
tools/validate-file-refs.js

# Skill dev/test artifacts (not needed at runtime)
skills/**/.analysis/
skills/**/.decision-log.md
skills/**/.memlog.md
skills/**/scripts/tests/
skills/**/__pycache__/
skills/**/.pytest_cache/
skills/reports/
skills/ultracode-goal/assets/ucg-awareness/shaping-decision.md

# Python bytecode
__pycache__/
*.pyc

# Output and temp
temp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Misc
*.log
.env
.env.*

# Browser-automation session artifacts (screenshots, snapshots)
.playwright-mcp/

# Learning material scaffold: gitignored, so npm would otherwise pack a stale copy
_ucg-learn/

# Local build and generated output. These are gitignored, but the presence of
# this file disables npm's .gitignore fallback entirely, so they must be listed
# here too or a pack from a working tree carries them (measured: 367 files /
# 21.2 MB against the 97 a release publishes from a clean CI checkout).
build/
data/
graphify-out/
